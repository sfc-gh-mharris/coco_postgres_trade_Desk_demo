# Break Desk demo configuration.
# Copy to config/demo.env and edit. config/demo.env is gitignored.
# Every Snowflake object name is derived from PREFIX, so two installs can share an account.

# ---- Snowflake connection (from `snow connection list`) -------------------------------
SNOW_CONNECTION=default

# ---- Naming ---------------------------------------------------------------------------
# Upper-case letters, digits, underscore. Database = PREFIX; warehouse = PREFIX_WH; etc.
PREFIX=BREAK_DESK

# ---- Which approval UI to deploy: streamlit | node | both ------------------------------
UI=both

# ---- Extra Snowflake users who should get the approver role (comma-separated).
# The installing user always gets it.
APPROVER_USERS=

# ---- Postgres -------------------------------------------------------------------------
# create   = the installer creates a new Snowflake Postgres instance (recommended)
# existing = reuse PG_INSTANCE; you must create the admin secret yourself (see docs/INSTALL.md)
PG_MODE=create
PG_INSTANCE=
PG_COMPUTE_FAMILY=STANDARD_M
PG_STORAGE_GB=50
PG_VERSION=18

# Mirror refresh: 30 seconds | 1 minute | 10 minutes
MIRROR_REFRESH="30 seconds"

# ---- Compute --------------------------------------------------------------------------
POOL_INSTANCE_FAMILY=CPU_X64_S
POOL_MAX_NODES=3

# ---- Models (must be callable from this account; preflight checks each one) ------------
INVESTIGATOR_MODEL=gemini-3.8-flash
INVESTIGATOR_ALT_MODEL=claude-haiku-4-5
QC_MODEL=claude-opus-5-5
FLIGHT_RECORDER_MODEL=claude-opus-5-5
# If a model is not available in-region the installer offers to set
# CORTEX_ENABLED_CROSS_REGION to this value (it asks first). NONE disables the offer.
CROSS_REGION_OFFER=ANY_REGION
